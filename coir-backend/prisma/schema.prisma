generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  INDIVIDUAL
  BUSINESS
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REJECTED
  UNDER_REVIEW

  CLARIFICATION_SOUGHT

  VERIFIED
  APPROVED
}

model User {
  id Int @id @default(autoincrement())

  mobile   String  @unique
  email    String? @unique
  password String?

  otpHash          String?
  otpExpiresAt     DateTime?
  refreshTokenHash String?

  userType UserType

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?

  applications Application[]
}

model Profile {
  id Int @id @default(autoincrement())

  userId Int @unique

  fullName String

  dob DateTime?

  gender String?

  fatherName String?
  caste      String?

  photo String?

  address    String?
  city       String?
  district   String?
  state      String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Scheme {
  id Int @id @default(autoincrement())

  code String @unique

  name String

  description String?

  duration String?

  stipend Decimal? @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
  programs     Program[]
}

model TrainingCentre {
  id Int @id @default(autoincrement())

  name String

  district String?

  state String?

  address String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Program {
  id Int @id @default(autoincrement())

  schemeId Int

  title String

  category String?

  duration String?

  benefit String?

  level String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheme Scheme @relation(fields: [schemeId], references: [id])

  applications Application[]
}

model Application {
  id Int @id @default(autoincrement())

  applicationNo String @unique

  userId Int

  schemeId Int

  programId Int

  trainingCentreId Int?

  status ApplicationStatus @default(DRAFT)

  currentStep Int @default(1)

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  scheme Scheme @relation(fields: [schemeId], references: [id])

  program Program @relation(fields: [programId], references: [id])

  trainingCentre TrainingCentre? @relation(fields: [trainingCentreId], references: [id])

  detail ApplicationDetail?

  logs ApplicationLog[]
}

model ApplicationDetail {
  id Int @id @default(autoincrement())

  applicationId Int @unique

  personalDetails Json?

  experienceDetails Json?

  bankDetails Json?

  documents Json?

  declarationAcceptedAt DateTime?

  declarationAccepted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

//future approval tracking ke liye

model ApplicationLog {
  id Int @id @default(autoincrement())

  applicationId Int

  action String

  remarks String?

  createdAt DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id])
}

// Showroom Procurement & Inventory Models

model InventoryItem {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String   @unique
  category    String
  quantity    Int
  unit        String
  unitPrice   Decimal  @db.Decimal(10, 2)
  stockStatus String // "AVAILABLE", "LOW STOCK", "OUT OF STOCK"
  supplier    String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id           String             @id @default(uuid())
  name         String
  rating       Float
  stars        Int
  availability String // "IN STOCK", "LIMITED", "OUT OF STOCK"
  stock        Int
  fulfillment  String
  base         Decimal            @db.Decimal(10, 2)
  trans        Decimal            @db.Decimal(10, 2)
  tax          Decimal            @db.Decimal(10, 2)
  total        Decimal            @db.Decimal(10, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  responses    SupplierResponse[]
  allocations  OrderAllocation[]
}

model Demand {
  id          String             @id
  category    String
  productName String
  dateText    String
  qty         String
  status      String // "SUBMITTED", "RESPONDED", "ORDER RAISED", "ORDER PLACED"
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  responses   SupplierResponse[]
  orders      Order[]
}

model SupplierResponse {
  id         Int      @id @default(autoincrement())
  demandId   String
  supplierId String
  base       Decimal  @db.Decimal(10, 2)
  trans      Decimal  @db.Decimal(10, 2)
  tax        Decimal  @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  demand   Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([demandId, supplierId])
}

model Order {
  id          Int      @id @default(autoincrement())
  demandId    String   @unique
  category    String
  productName String
  orderDate   String
  totalQty    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  demand      Demand            @relation(fields: [demandId], references: [id], onDelete: Cascade)
  allocations OrderAllocation[]
}

model OrderAllocation {
  id           Int      @id @default(autoincrement())
  orderId      Int
  supplierId   String
  supplierName String
  rating       Float
  stars        Int
  allocatedQty String
  fulfillment  String
  base         Decimal  @db.Decimal(10, 2)
  trans        Decimal  @db.Decimal(10, 2)
  tax          Decimal  @db.Decimal(10, 2)
  total        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}
